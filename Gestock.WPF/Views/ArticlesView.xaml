<UserControl x:Class="SuperMarcheApp.Views.ArticlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Inventaire des Articles"
                       FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Gérez vos produits, prix et niveaux de stock."
                       Foreground="#7F8C8D" FontSize="13"/>
        </StackPanel>

        <!-- Formulaire -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="20" BorderBrush="#DCDDE1" BorderThickness="1">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel Margin="10,5">
                    <TextBlock Text="Code-barres" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBarcode" Width="180" Height="32"
                             Tag="Code-barres"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Nom du produit" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNom" Width="180" Height="32"
                             Tag="Ex: Coca Cola 1L"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Catégorie" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboCategorie" Width="180" Height="32"
          Tag="-- Choisir --"
          SelectedValuePath="CategoryId">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Prix d'achat (DA)" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrixAchat" Width="180" Height="32"
                             Tag="0.00"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Prix de vente (DA)" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrixVente" Width="180" Height="32"
                             Tag="0.00"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Quantité stock" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtStock" Width="180" Height="32"
                             Tag="0"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Unité" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboUnit" Width="180" Height="32"
                              Tag="-- Choisir --">
                        <ComboBoxItem Content="Pièces" IsSelected="True"/>
                        <ComboBoxItem Content="Kgs"/>
                        <ComboBoxItem Content="Cartons"/>
                        <ComboBoxItem Content="Bidons"/>
                        <ComboBoxItem Content="Bouteilles"/>
                        <ComboBoxItem Content="Paquets"/>
                        <ComboBoxItem Content="Sacs"/>
                        <ComboBoxItem Content="Litres"/>
                        <ComboBoxItem Content="Autres"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Seuil d'alerte" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtStockMin" Width="180" Height="32"
                             Tag="5"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15">
            <Button Content="Enregistrer" 
                    Click="BtnSave_Click" 
                    Background="#27AE60"
                    Foreground="White" Width="130" Height="35"
                    Margin="5,0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Annuler" 
                    Click="BtnCancel_Click" 
                    Background="#E74C3C"
                    Foreground="White" Width="130" Height="35"
                    Margin="5,0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Tableau -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                BorderBrush="#DCDDE1" BorderThickness="1" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filtre -->
                <Border Grid.Row="0" Background="#F8F9FA"
                        CornerRadius="10,10,0,0"
                        BorderBrush="#DCDDE1" BorderThickness="0,0,0,1"
                        Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Filtrer par catégorie :"
                                   FontWeight="SemiBold" Foreground="#34495E"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cboFiltreCategorie" Width="180" Height="30"
                                  Tag="-- Toutes --"
                                  SelectedValuePath="CategoryId"
                                  SelectionChanged="CboFiltre_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="🔄 Actualiser" Background="#2980B9"
                                Foreground="White" Width="110" Height="30"
                                Margin="15,0,0,0" BorderThickness="0"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock x:Name="lblArticleCount"
                                   Text="• 0 articles" Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="dgArticles" 
                          SelectionChanged="DgArticles_SelectionChanged"
                          Grid.Row="1"
                          ItemsSource="{Binding Articles}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F2F6"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="35" FontSize="13"
                          HeadersVisibility="Column"
                          IsReadOnly="True">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#34495E"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#DCDDE1"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code-barres"
                                            Binding="{Binding Barcode}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Désignation"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Catégorie"
                                            Binding="{Binding CategoryName}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Unité"
                                            Binding="{Binding Unit}"
                                            Width="80"/>
                        <DataGridTextColumn Header="P. Achat"
                                            Binding="{Binding PurchasePrice, StringFormat={}{0:N2} DA}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="P. Vente"
                                            Binding="{Binding SellingPrice, StringFormat={}{0:N2} DA}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding StockQuantity}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Alerte"
                                            Binding="{Binding MinStockAlert}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Click="BtnEdit_Click" Command="{Binding DataContext.EditCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="White" Foreground="#2980B9"
                                                Width="25" Height="25"
                                                Margin="2,0" BorderThickness="0"
                                                Cursor="Hand">
                                            <fa:FontAwesome Icon="Pencil" FontSize="14"/>
                                        </Button>
                                        <Button Click="BtnRowDelete_Click" Command="{Binding DataContext.DeleteCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="White" Foreground="#E74C3C"
                                                Width="25" Height="25"
                                                Margin="2,0" BorderThickness="0"
                                                Cursor="Hand">
                                            <fa:FontAwesome Icon="Trash" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>