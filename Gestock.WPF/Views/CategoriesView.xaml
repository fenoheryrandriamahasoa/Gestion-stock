<UserControl x:Class="SuperMarcheApp.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Classification des Produits"
                       FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Organisez vos articles par catégories."
                       Foreground="#7F8C8D" FontSize="13"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulaire -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Padding="20" BorderBrush="#DCDDE1" BorderThickness="1"
                    VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Nouvelle Catégorie" FontSize="16"
                               FontWeight="SemiBold" Foreground="#34495E"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Nom de la catégorie"
                               Foreground="#7F8C8D" Margin="0,0,0,5"/>

                    <TextBox x:Name="txtCategoryName"
                             Tag="Ex: Boissons"
                             Height="35"/>

                    <TextBlock Text="Description (Optionnel)"
                               Foreground="#7F8C8D" Margin="0,15,0,5"/>

                    <TextBox x:Name="txtCategoryDescription"
                             Tag="Description de la catégorie..."
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <Button x:Name="btnSaveCategory" 
                            Click="BtnSave_Click"
                            Content="Enregistrer"
                            Background="#27AE60" Foreground="White"
                            Height="38" Margin="0,25,0,5"
                            BorderThickness="0" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="btnDeleteCategory" 
                            Click="BtnDelete_Click"
                            Content="Supprimer la sélection"
                            Background="#E74C3C" Foreground="White"
                            Height="38" Margin="0,5,0,0"
                            BorderThickness="0" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Liste -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#DCDDE1" BorderThickness="1">
                <DataGrid x:Name="dgCategories"
                        ItemsSource="{Binding Categories}"
                        SelectionChanged="DgCategories_SelectionChanged"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="#F1F2F6"
                        BorderThickness="0"
                        Background="Transparent"
                        RowHeight="40"
                        IsReadOnly="True">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#34495E"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#DCDDE1"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding CategoryID}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Nom"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>