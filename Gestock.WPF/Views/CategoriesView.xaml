<UserControl x:Class="SuperMarcheApp.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="*"/>
            <!-- Contenu -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════ -->
        <!--  EN-TÊTE                              -->
        <!-- ══════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="FolderOpen"
                                    Foreground="#2C3E50"
                                    Width="26" Height="26"
                                    Margin="0,0,10,0"/>
                    <TextBlock Text="GESTION DES CATÉGORIES"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Organisez vos articles par catégories pour une meilleure gestion."
                           Foreground="#7F8C8D" FontSize="13"
                           Margin="36,5,0,0"/>
            </StackPanel>

            <!-- Compteur -->
            <Border Grid.Column="1" Background="White"
                    CornerRadius="8" Padding="15,8"
                    BorderBrush="#DCDDE1" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock  Icon="Tags" Foreground="#2980B9"
                                    Width="16" Height="16"
                                    Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblCategoryCount"
                               Text="0 catégorie(s)"
                               Foreground="#34495E" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════ -->
        <!--  CONTENU : Formulaire + Liste         -->
        <!-- ══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <!-- Formulaire -->
                <ColumnDefinition Width="*"/>
                <!-- Liste -->
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════ -->
            <!--  COLONNE GAUCHE : FORMULAIRE    -->
            <!-- ════════════════════════════════ -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">

                <!-- Carte formulaire -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel>

                        <!-- Titre formulaire dynamique -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border x:Name="brdFormIcon"
                                    Background="#EBF5FB" CornerRadius="8"
                                    Width="36" Height="36" Margin="0,0,10,0">
                                <fa:IconBlock x:Name="icnForm"
                                                Icon="Plus" Foreground="#2980B9"
                                                Width="16" Height="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lblFormTitle"
                                           Text="Nouvelle Catégorie"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#2C3E50"/>
                                <TextBlock x:Name="lblFormSubtitle"
                                           Text="Remplissez les informations ci-dessous"
                                           Foreground="#95A5A6" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Nom -->
                        <TextBlock Text="Nom de la catégorie *"
                                   Foreground="#34495E" FontWeight="SemiBold"
                                   Margin="0,0,0,5" FontSize="12"/>
                        <TextBox x:Name="txtCategoryName"
                                 Tag="Ex: Boissons, Épicerie..."
                                 Height="38" FontSize="13"/>

                        <!-- Description -->
                        <TextBlock Text="Description (optionnel)"
                                   Foreground="#34495E" FontWeight="SemiBold"
                                   Margin="0,15,0,5" FontSize="12"/>
                        <TextBox x:Name="txtCategoryDescription"
                                 Tag="Décrivez cette catégorie..."
                                 Height="80" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 FontSize="13"/>

                        <!-- Boutons -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnSaveCategory"
                                    Content="💾 Enregistrer"
                                    Click="BtnSave_Click"
                                    Background="#27AE60" Foreground="White"
                                    Height="40" Margin="0,0,4,0"
                                    BorderThickness="0" FontWeight="Bold"
                                    FontSize="13" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="btnCancel"
                                    Content="✕ Annuler"
                                    Click="BtnCancel_Click"
                                    Background="#95A5A6" Foreground="White"
                                    Height="40" Margin="4,0,0,0"
                                    BorderThickness="0" FontWeight="Bold"
                                    FontSize="13" Cursor="Hand"
                                    Grid.Column="1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Aide / Info -->
                <Border Background="#FDF2E9" CornerRadius="8" Padding="12"
                        BorderBrush="#F0C27B" BorderThickness="1"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="#7F6C3E">
                            <Run FontWeight="SemiBold">Astuce :</Run>
                            <Run>Cliquez sur une catégorie dans la liste pour la modifier. Une catégorie ne peut être supprimée que si aucun produit ne l'utilise.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ════════════════════════════════ -->
            <!--  COLONNE DROITE : LISTE         -->
            <!-- ════════════════════════════════ -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#DCDDE1" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Barre recherche -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Barre de recherche -->
                    <Border Grid.Row="0" Background="#F8F9FA"
                            CornerRadius="10,10,0,0"
                            BorderBrush="#DCDDE1" BorderThickness="0,0,0,1"
                            Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtSearch"
                                     Width="250" Height="30"
                                     Tag="🔍 Rechercher une catégorie..."
                                     HorizontalAlignment="Left"
                                     TextChanged="TxtSearch_TextChanged"/>

                            <TextBlock Grid.Column="1"
                                       x:Name="lblFilterCount"
                                       Text="• 0 résultat(s)"
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgCategories"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F2F6"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="50" FontSize="13"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionChanged="DgCategories_SelectionChanged">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="Foreground" Value="#34495E"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <!-- ID avec icône -->
                            <DataGridTemplateColumn Header="#" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EBF5FB"
                                                CornerRadius="5"
                                                Width="35" Height="28"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryId}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="#2980B9"
                                                       FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nom -->
                            <DataGridTemplateColumn Header="Nom" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2C3E50"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#95A5A6"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nombre de produits -->
                            <DataGridTemplateColumn Header="Produits" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F0F9EB"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#27AE60"
                                                       FontWeight="SemiBold">
                                                <Run Text="{Binding ProductCount, Mode=OneWay}"/>
                                                <Run Text=" art."/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <!-- Éditer -->
                                            <Button Click="BtnEdit_Click"
                                                    Background="#EBF5FB"
                                                    Foreground="#2980B9"
                                                    Width="32" Height="32"
                                                    Margin="2,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Modifier">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                                <fa:IconBlock Icon="Pencil" FontSize="13"/>
                                            </Button>

                                            <!-- Supprimer -->
                                            <Button Click="BtnDelete_Click"
                                                    Background="#FDEDEC"
                                                    Foreground="#E74C3C"
                                                    Width="32" Height="32"
                                                    Margin="2,0"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Supprimer">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                                <fa:IconBlock Icon="Trash" FontSize="13"/>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Message si vide -->
                    <TextBlock Grid.Row="1"
                               x:Name="lblEmpty"
                               Text="📂 Aucune catégorie trouvée"
                               Foreground="#BDC3C7"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>