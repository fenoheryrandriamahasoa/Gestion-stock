<UserControl x:Class="SuperMarcheApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             Background="#F4F7F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
        <StackPanel>

            <!-- ══════════════════════════════════════ -->
            <!--  TITRE + DATE                         -->
            <!-- ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tableau de bord"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#34495E"/>

                <TextBlock Grid.Column="1"
                           x:Name="lblDate"
                           Foreground="#7F8C8D" FontSize="13"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!--  LIGNE 1 : KPI PRINCIPALES            -->
            <!-- ══════════════════════════════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,10">

                <Border Background="White" CornerRadius="8"
                        Margin="0,0,8,0" Padding="15"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💰 Ventes du jour"
                                   Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="lblDashVentes"
                                   Text="0.00" FontSize="22"
                                   FontWeight="Bold" Foreground="#27AE60"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="lblDashNbVentes"
                                   Text="0 transaction(s)"
                                   Foreground="#BDC3C7" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="4,0" Padding="15"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📦 Articles en stock"
                                   Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="lblDashArticles"
                                   Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#2980B9"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="lblDashTotalStock"
                                   Text="0 unités totales"
                                   Foreground="#BDC3C7" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="4,0" Padding="15"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚠️ Alertes Stock Bas"
                                   Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="lblDashAlertes"
                                   Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#E67E22"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="lblDashRupture"
                                   Text="0 en rupture"
                                   Foreground="#E74C3C" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="8,0,0,0" Padding="15"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📥 Appro. du mois"
                                   Foreground="#7F8C8D" FontSize="12"/>
                        <TextBlock x:Name="lblDashAppro"
                                   Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#8E44AD"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="lblDashApproQty"
                                   Text="0 unités ajoutées"
                                   Foreground="#BDC3C7" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════ -->
            <!--  LIGNE 2 : PAIEMENTS DU JOUR          -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="Répartition des paiements (aujourd'hui)"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#34495E" Margin="0,10,0,8"/>

            <UniformGrid Columns="5" Margin="0,0,0,15">

                <Border Background="White" CornerRadius="8"
                        Margin="0,0,5,0" Padding="12"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💵 Espèces" Foreground="#7F8C8D"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPayEspeces" Text="0.00"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#27AE60"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="3,0" Padding="12"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💳 Carte" Foreground="#7F8C8D"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPayCarte" Text="0.00"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#2980B9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="3,0" Padding="12"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📝 Chèque" Foreground="#7F8C8D"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPayCheque" Text="0.00"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#E67E22"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="3,0" Padding="12"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📱 Mobile Money" Foreground="#7F8C8D"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPayMobile" Text="0.00"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#16A085"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8"
                        Margin="5,0,0,0" Padding="12"
                        BorderBrush="#DCDDE1" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊 Transactions" Foreground="#7F8C8D"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPayCount" Text="0"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#34495E"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════ -->
            <!--  LIGNE 3 : GRAPHIQUES BARRES XAML     -->
            <!-- ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventes des 7 derniers jours -->
                <Border Grid.Column="0" Background="White" CornerRadius="8"
                        Padding="15" BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📈 Ventes des 7 derniers jours"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#34495E" Margin="0,0,0,10"/>
                        <!-- Barres générées par le code -->
                        <StackPanel x:Name="pnlWeeklyBars"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Height="180"/>
                    </StackPanel>
                </Border>

                <!-- Top 5 produits vendus -->
                <Border Grid.Column="1" Background="White" CornerRadius="8"
                        Padding="15" BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🏆 Top 5 produits vendus (mois)"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#34495E" Margin="0,0,0,10"/>
                        <!-- Barres horizontales générées par le code -->
                        <StackPanel x:Name="pnlTopProducts"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!--  LIGNE 4 : APPRO + RÉPARTITION        -->
            <!-- ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Approvisionnements par semaine -->
                <Border Grid.Column="0" Background="White" CornerRadius="8"
                        Padding="15" BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📥 Approvisionnements du mois"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#34495E" Margin="0,0,0,10"/>
                        <StackPanel x:Name="pnlApproBars"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Height="180"/>
                    </StackPanel>
                </Border>

                <!-- Répartition paiements du mois -->
                <Border Grid.Column="1" Background="White" CornerRadius="8"
                        Padding="15" BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🥧 Répartition paiements (mois)"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#34495E" Margin="0,0,0,10"/>
                        <StackPanel x:Name="pnlPaymentBars"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════ -->
            <!--  LIGNE 5 : DERNIÈRES FACTURES         -->
            <!-- ══════════════════════════════════════ -->
            <TextBlock Text="Dernières Factures" FontSize="16"
                       FontWeight="SemiBold" Foreground="#34495E"
                       Margin="0,0,0,8"/>

            <Border Background="White" CornerRadius="8" Padding="10"
                    BorderBrush="#DCDDE1" BorderThickness="1"
                    Margin="0,0,0,15">
                <StackPanel x:Name="pnlLastSales">
                    <TextBlock Text="Chargement..."
                               Foreground="#BDC3C7" Padding="10"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>