<UserControl x:Class="SuperMarcheApp.Views.HistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="Auto"/>
            <!-- Filtres -->
            <RowDefinition Height="*"/>
            <!-- Tableau ventes -->
            <RowDefinition Height="Auto"/>
            <!-- Résumé -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════ -->
        <!--  EN-TÊTE                              -->
        <!-- ══════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa:FontAwesome Icon="History"
                                Foreground="#2C3E50"
                                Width="26" Height="26"
                                Margin="0,0,10,0"/>
                <TextBlock Text="HISTORIQUE DES VENTES"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="lblDateJour"
                       Foreground="#7F8C8D" FontSize="13"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ══════════════════════════════════════ -->
        <!--  FILTRES                              -->
        <!-- ══════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="15" BorderBrush="#DCDDE1" BorderThickness="1"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Date début -->
                <StackPanel Margin="10,5">
                    <TextBlock Text="Du" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDateFrom"
                                Width="140" Height="32"
                                SelectedDateChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Date fin -->
                <StackPanel Margin="10,5">
                    <TextBlock Text="Au" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDateTo"
                                Width="140" Height="32"
                                SelectedDateChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Vendeur -->
                <StackPanel Margin="10,5">
                    <TextBlock Text="Vendeur" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <!-- ComboBox Vendeur -->
                    <ComboBox x:Name="cboVendeur" Width="160" Height="32"
                              Tag="-- Tous --"
                              SelectedValuePath="UserId"
                              SelectionChanged="Filter_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Username}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Recherche facture -->
                <StackPanel Margin="10,5">
                    <TextBlock Text="N° Facture" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSearchInvoice"
                             Width="160" Height="32"
                             Tag="🔍 Rechercher..."
                             TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <!-- Mode paiement -->
                <StackPanel Margin="10,5">
                    <TextBlock Text="Paiement" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboPayment"
                              Width="130" Height="32"
                              Tag="-- Tous --"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="Tous" IsSelected="True"/>
                        <ComboBoxItem Content="Espèces"/>
                        <ComboBoxItem Content="Carte"/>
                        <ComboBoxItem Content="Chèque"/>
                    </ComboBox>
                </StackPanel>

                <!-- Bouton réinitialiser -->
                <StackPanel Margin="10,5" VerticalAlignment="Bottom">
                    <Button Content="🔄 Réinitialiser"
                            Click="BtnReset_Click"
                            Background="#95A5A6" Foreground="White"
                            Width="120" Height="32"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ══════════════════════════════════════ -->
        <!--  CONTENU : Ventes + Détails           -->
        <!-- ══════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Liste des ventes -->
                <ColumnDefinition Width="320"/>
                <!-- Détail facture -->
            </Grid.ColumnDefinitions>

            <!-- LISTE DES VENTES -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#DCDDE1" BorderThickness="1"
                    ClipToBounds="True" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header du tableau -->
                    <Border Grid.Row="0" Background="#F8F9FA"
                            CornerRadius="10,10,0,0"
                            BorderBrush="#DCDDE1" BorderThickness="0,0,0,1"
                            Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesome Icon="FileTextOutline"
                                            Foreground="#34495E"
                                            Width="16" Height="16"
                                            Margin="0,0,8,0"/>
                            <TextBlock Text="Factures"
                                       FontWeight="Bold" Foreground="#34495E"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblSaleCount"
                                       Text="• 0 vente(s)"
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid des ventes -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgSales"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F2F6"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="38" FontSize="13"
                              IsReadOnly="True"
                              SelectionChanged="DgSales_SelectionChanged"
                              HeadersVisibility="Column">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="Foreground" Value="#34495E"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° Facture"
                                                Binding="{Binding InvoiceNumber}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Vendeur"
                                                Binding="{Binding Vendeur}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding TotalAmount, StringFormat={}{0:N2} DA}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Paiement"
                                                Binding="{Binding PaymentMethod}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DÉTAIL DE LA FACTURE SÉLECTIONNÉE -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#DCDDE1" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Info facture -->
                        <RowDefinition Height="*"/>
                        <!-- Lignes -->
                        <RowDefinition Height="Auto"/>
                        <!-- Total -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#2C3E50"
                            CornerRadius="10,10,0,0" Padding="15,10">
                        <TextBlock x:Name="lblDetailTitle"
                                   Text="Détail de la facture"
                                   Foreground="White" FontWeight="Bold"
                                   FontSize="14"/>
                    </Border>

                    <!-- Info facture -->
                    <StackPanel Grid.Row="1" Margin="15,10">
                        <TextBlock x:Name="lblDetailInvoice"
                                   Text="N° : —" FontWeight="SemiBold"
                                   Foreground="#2C3E50" FontSize="13"/>
                        <TextBlock x:Name="lblDetailDate"
                                   Text="Date : —" Foreground="#7F8C8D"
                                   FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lblDetailVendeur"
                                   Text="Vendeur : —" Foreground="#7F8C8D"
                                   FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="lblDetailPayment"
                                   Text="Paiement : —" Foreground="#7F8C8D"
                                   FontSize="12" Margin="0,3,0,0"/>
                        <Separator Margin="0,10,0,5" Background="#DCDDE1"/>
                    </StackPanel>

                    <!-- Lignes de la facture -->
                    <DataGrid Grid.Row="2"
                              x:Name="dgDetails"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="30" FontSize="12"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Margin="5,0">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                <Setter Property="Padding" Value="5,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#DCDDE1"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produit"
                                                Binding="{Binding ProductName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Qté"
                                                Binding="{Binding Quantity}"
                                                Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="P.U."
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="S/Total"
                                                Binding="{Binding SubTotal, StringFormat={}{0:N2}}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total de la facture -->
                    <Border Grid.Row="3" Background="#F8F9FA"
                            Padding="15,10"
                            BorderBrush="#DCDDE1" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TOTAL"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="#2C3E50"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="lblDetailTotal"
                                       Text="0.00 DA"
                                       FontWeight="Bold" FontSize="18"
                                       Foreground="#27AE60"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════ -->
        <!--  RÉSUMÉ EN BAS                        -->
        <!-- ══════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                Padding="20,12" BorderBrush="#DCDDE1" BorderThickness="1"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nombre de ventes -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Nb. Ventes" Foreground="#7F8C8D"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTotalVentes"
                               Text="0" FontSize="20" FontWeight="Bold"
                               Foreground="#2980B9"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Chiffre d'affaires -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Chiffre d'affaires" Foreground="#7F8C8D"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblChiffreAffaires"
                               Text="0.00 DA" FontSize="20" FontWeight="Bold"
                               Foreground="#27AE60"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Espèces -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Espèces" Foreground="#7F8C8D"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTotalEspeces"
                               Text="0.00 DA" FontSize="20" FontWeight="Bold"
                               Foreground="#E67E22"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Carte -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Carte" Foreground="#7F8C8D"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblTotalCarte"
                               Text="0.00 DA" FontSize="20" FontWeight="Bold"
                               Foreground="#8E44AD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>