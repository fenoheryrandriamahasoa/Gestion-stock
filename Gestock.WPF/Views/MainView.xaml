<Window x:Class="SuperMarcheApp.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestion Supermarché"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar  -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">

            <Border.Resources>
                <Style x:Key="SidebarButton" TargetType="Button">
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="Margin" Value="0,3"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#BDC3C7"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="15,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg"
                                                Property="Background"
                                                Value="#34495E"/>
                                        <Setter Property="Foreground"
                                                Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <DockPanel>
                <TextBlock x:Name="lblStoreName"
                           Text="SUPERMARCHÉ"
                           DockPanel.Dock="Top"
                           Foreground="White"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,10,0,30"
                           TextAlignment="Center"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="#5D6D7E" Margin="0,10"/>
                    <Button Content="🚪 Déconnexion" Height="40"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0"
                            Click="Deconnexion_Click"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <Button Content="🏠 Tableau de bord"
                            Style="{StaticResource SidebarButton}"
                            Click="Dashboard_Click"/>
                    <Button Content="💰 Point de Vente"
                            Style="{StaticResource SidebarButton}"
                            Click="PointDeVentes_Click"/>
                    <Button Content="📦 Articles"
                            Style="{StaticResource SidebarButton}"
                            Click="Articles_Click"/>
                    <Button Content="📂 Catégories"
                            Style="{StaticResource SidebarButton}"
                            Click="Catégories_Click"/>
                    <Button Content="📥 Approvisionnement"
                            Style="{StaticResource SidebarButton}"
                            Click="Approvisionnement_Click"/>
                    <Button Content="📋 Historique"
                            Style="{StaticResource SidebarButton}"
                            Click="Facturation_Click"/>
                    <Button Content="👤 Utilisateurs"
                            Style="{StaticResource SidebarButton}"
                            Click="Users_Click"/>
                    <Button Content="⚙️ Paramètres"
                            Style="{StaticResource SidebarButton}"
                            Click="Parametres_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Contenu principal VIDE -->
        <Grid Grid.Column="1" Background="#F4F7F6">
            <ContentControl x:Name="MainContent" Content="{x:Null}"/>
        </Grid>
    </Grid>
</Window>