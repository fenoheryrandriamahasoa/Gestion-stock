<UserControl x:Class="SuperMarcheApp.Views.ParametresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Cog" Foreground="#2C3E50"
                                Width="26" Height="26" Margin="0,0,10,0"/>
                <TextBlock Text="PARAMÈTRES" FontSize="26"
                           FontWeight="Bold" Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Configurez votre application selon vos besoins."
                       Foreground="#7F8C8D" FontSize="13" Margin="36,5,0,0"/>
        </StackPanel>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══════════════════════════════ -->
                <!--  🏪 INFORMATIONS DU MAGASIN    -->
                <!-- ══════════════════════════════ -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <fa:IconBlock Icon="Home" Foreground="#2980B9"
                                            Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Informations du magasin"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                        </StackPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,10" Width="250">
                                <TextBlock Text="Nom du magasin"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtStoreName" Height="35"
                                         Tag="Ex: Mon Supermarché"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,10" Width="300">
                                <TextBlock Text="Adresse"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtStoreAddress" Height="35"
                                         Tag="Ex: 123 Rue Principale"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,10" Width="200">
                                <TextBlock Text="Téléphone"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtStorePhone" Height="35"
                                         Tag="Ex: +213 555 123 456"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════ -->
                <!--  💰 MONNAIE                    -->
                <!-- ══════════════════════════════ -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <fa:IconBlock Icon="MoneyBill" FontSize="13" Foreground="#27AE60" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Devise / Monnaie"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#2C3E50"/>
                        </StackPanel>

                        <WrapPanel>

                            <!-- Deux options : liste OU saisie manuelle -->
                            <StackPanel Margin="0,0,20,10" Width="200">
                                <TextBlock Text="Choisir une devise"
                           FontWeight="SemiBold" Foreground="#34495E"
                           Margin="0,0,0,5"/>
                                <!-- ComboBox NON éditable (fonctionne avec le style global) -->
                                <ComboBox x:Name="cboCurrency" Height="35"
                          Tag="-- Choisir --"
                          SelectionChanged="CboCurrency_SelectionChanged">
                                    <ComboBoxItem Content="Ar"   Tag="Ariary Malgache"/>
                                    <ComboBoxItem Content="DA"   Tag="Dinar Algérien"/>
                                    <ComboBoxItem Content="€"    Tag="Euro"/>
                                    <ComboBoxItem Content="$"    Tag="Dollar US"/>
                                    <ComboBoxItem Content="FCFA" Tag="Franc CFA"/>
                                    <ComboBoxItem Content="MAD"  Tag="Dirham Marocain"/>
                                    <ComboBoxItem Content="TND"  Tag="Dinar Tunisien"/>
                                    <ComboBoxItem Content="£"    Tag="Livre Sterling"/>
                                    <ComboBoxItem Content="CHF"  Tag="Franc Suisse"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- OU saisie manuelle si la devise n'est pas dans la liste -->
                            <StackPanel Margin="0,0,20,10" Width="200">
                                <TextBlock Text="Ou saisir manuellement"
                           FontWeight="SemiBold" Foreground="#34495E"
                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCurrencyManual" Height="35"
                         Tag="Ex: XOF, BRL..."
                         TextChanged="TxtCurrencyManual_TextChanged"/>
                            </StackPanel>

                            <!-- Position -->
                            <StackPanel Margin="0,0,20,10" Width="260">
                                <TextBlock Text="Position de la devise"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cboCurrencyPosition" Height="35"
                                          SelectionChanged="CboCurrencyPosition_SelectionChanged">
                                    <ComboBoxItem x:Name="optAfter" Content="Après le montant (100.00 Ar)"
                                                  IsSelected="True"/>
                                    <ComboBoxItem x:Name="optBefore" Content="Avant le montant (Ar 100.00)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Aperçu -->
                            <StackPanel Margin="0,0,20,10" VerticalAlignment="Bottom">
                                <TextBlock Text="Aperçu :" Foreground="#7F8C8D"
                           FontSize="11" Margin="0,0,0,3"/>
                                <Border Background="#F8F9FA" CornerRadius="5"
                        Padding="15,8" BorderBrush="#27AE60"
                        BorderThickness="2">
                                    <TextBlock x:Name="lblPreviewPrice"
                               Text="1 250.00 DA"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#27AE60"/>
                                </Border>
                            </StackPanel>

                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- ══════════════════════════════ -->
                <!--  🧾 FACTURATION                -->
                <!-- ══════════════════════════════ -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <fa:IconBlock Icon="FileText" Foreground="#E67E22"
                                            Width="18" Height="18" Margin="0,0,8,0"/>
                            
                            <TextBlock Text="Facturation"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                        </StackPanel>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,10" Width="200">
                                <TextBlock Text="Préfixe des factures"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtInvoicePrefix" Height="35"
                                         Tag="Ex: FAC, INV, BILL..."
                                         TextChanged="TxtInvoicePrefix_TextChanged"/>
                                <TextBlock x:Name="lblPreviewInvoice"
                                           Text="Aperçu : FAC-2025-0001"
                                           Foreground="#7F8C8D" FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,10" Width="350">
                                <TextBlock Text="Message de remerciement (ticket)"
                                           FontWeight="SemiBold" Foreground="#34495E"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtReceiptFooter" Height="35"
                                         Tag="Ex: Merci pour votre achat !"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════ -->
                <!--  📦 STOCK                      -->
                <!-- ══════════════════════════════ -->
                <Border Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#DCDDE1" BorderThickness="1"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <fa:IconBlock Icon="Archive" Foreground="#E74C3C"
                                            Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Gestion du stock"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,10" Width="250">
                            <TextBlock Text="Seuil d'alerte stock par défaut"
                                       FontWeight="SemiBold" Foreground="#34495E"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDefaultAlert" Height="35"
                                     Tag="Ex: 5"
                                     HorizontalContentAlignment="Center"/>
                            <TextBlock Text="Les produits dont le stock descend sous ce seuil apparaîtront en alerte."
                                       Foreground="#7F8C8D" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bouton sauvegarder -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="💾  Enregistrer les paramètres"
                    Background="#27AE60" Foreground="White"
                    Width="250" Height="42"
                    FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>