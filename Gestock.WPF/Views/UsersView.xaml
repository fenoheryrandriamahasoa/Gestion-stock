<UserControl x:Class="SuperMarcheApp.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Équipe de Vente"
                       FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Gérez les accès et les informations de vos collaborateurs."
                       Foreground="#7F8C8D" FontSize="13"/>
        </StackPanel>

        <!-- Formulaire -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="20" BorderBrush="#DCDDE1" BorderThickness="1">
            <WrapPanel HorizontalAlignment="Center">

                <StackPanel Margin="10,5">
                    <TextBlock Text="Nom d'utilisateur" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNomUser" Width="180" Height="32"
                             Tag="Nom utilisateur"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Mot de Passe" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Tag="Mot de passe"
                                 Width="180" Height="32"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Rôle" FontWeight="SemiBold"
                               Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cboRole" Width="180" Height="32"
                              Tag="-- Rôle --">
                        <ComboBoxItem Content="Seller" IsSelected="True"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="10,5" VerticalAlignment="Bottom">
                   
                    <CheckBox x:Name="ckbxActive"
                              Content="Actif"
                              IsChecked="True"
                              Margin="0,0,0,8"
                              FontSize="14"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15">
            <Button  Content="Enregistrer" Click="BtnSave_Click" Background="#27AE60"
                    Foreground="White" Width="130" Height="35"
                    Margin="5,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Annuler" Click="BtnCancel_Click" Background="#E74C3C"
                    Foreground="White" Width="130" Height="35"
                    Margin="5,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Tableau -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                BorderBrush="#DCDDE1" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filtre -->
                <Border Grid.Row="0" Background="#F8F9FA"
                        CornerRadius="10,10,0,0"
                        BorderBrush="#DCDDE1" BorderThickness="0,0,0,1"
                        Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtFiltreUser" TextChanged="TxtFiltre_TextChanged" Width="210" Height="30"
                                 Tag="🔍 Rechercher"/>
                        <TextBlock x:Name="lblUserCount"
                                   Text="• 0 Utilisateurs"
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

              
                <DataGrid x:Name="dgUsers" Grid.Row="1"
                          ItemsSource="{Binding Users}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F2F6"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="40" FontSize="13"
                          IsReadOnly="True">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#34495E"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#DCDDE1"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding UserID}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Nom"
                                            Binding="{Binding Username}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Rôle"
                                            Binding="{Binding Role}"
                                            Width="120"/>
                        
                        <DataGridTemplateColumn Header="Actif" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="❌"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="✅"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Click="BtnEdit_Click" Command="{Binding DataContext.EditCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="White" Foreground="#2980B9"
                                                Width="25" Height="25"
                                                Margin="2,0" BorderThickness="0"
                                                Cursor="Hand">
                                            <fa:FontAwesome Icon="Pencil" FontSize="14"/>
                                        </Button>
                                        <Button Click="BtnRowDelete_Click" Command="{Binding DataContext.DeleteCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="White" Foreground="#E74C3C"
                                                Width="25" Height="25"
                                                Margin="2,0" BorderThickness="0"
                                                Cursor="Hand">
                                            <fa:FontAwesome Icon="Trash" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>