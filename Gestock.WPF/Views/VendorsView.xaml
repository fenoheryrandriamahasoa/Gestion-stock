<UserControl x:Class="SuperMarcheApp.Views.VendorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F4F7F6">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="Auto"/>
            <!-- Formulaire -->
            <RowDefinition Height="Auto"/>
            <!-- Actions -->
            <RowDefinition Height="*"/>
            <!-- Tableau -->
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Équipe de Vente" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Gérez les accès et les informations de vos collaborateurs." Foreground="#7F8C8D" FontSize="13"/>
        </StackPanel>

        <!-- Formulaire (Carte) -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#DCDDE1" BorderThickness="1">
            <WrapPanel HorizontalAlignment="Center">
                <StackPanel Margin="10,5">
                    <TextBlock Text="Nom Complet" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Width="180" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Identifiant (Pseudo)" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Width="130" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Mot de Passe" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <PasswordBox Width="130" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Téléphone" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Width="130" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="10,5">
                    <TextBlock Text="Adresse" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Width="200" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Barre d'actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15">
            <Button Content="Enregistrer" Background="#27AE60" Foreground="White" Width="120" Height="35" Margin="5,0" BorderThickness="0" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Modifier" Background="#2980B9" Foreground="White" Width="120" Height="35" Margin="5,0" BorderThickness="0" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Supprimer" Background="#E74C3C" Foreground="White" Width="120" Height="35" Margin="5,0" BorderThickness="0" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Tableau des Vendeurs -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#DCDDE1" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Vendeurs}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F1F2F6" BorderThickness="0"
                      Background="Transparent" RowHeight="40">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Identifiant" Binding="{Binding Pseudo}" Width="150"/>
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="150"/>
                    <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
